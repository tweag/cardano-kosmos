let { Scenario, count_dreps, mk_complete_links, .. } = import "../schemas/scenario.ncl"
in {
  name = "vanilla",
  description = "6 SPOs, 2 relays, even stake, no faults",
  topology = {
    magic = 42,
    nodes = [
      { name = "pool2",
        role = 'spo,
        stake = 1/2,
      },
      { name = "pool4",
        role = 'spo,
        stake = 1/4,
      },
      { name = "pool8",
        role = 'spo,
        stake = 1/8,
      },
      { name = "pool16",
        role = 'spo,
        stake = 1/16,
      },
      { name = "pool32_1",
        role = 'spo,
        stake = 1/32,
      },
      { name = "pool32_2",
        role = 'spo,
        stake = 1/32,
      },
      { name = "relay1",
        role = 'relay,
      },
      { name = "relay2",
        role = 'relay,
      },
    ],
    links = mk_complete_links nodes,
  },
  genesis = {
    max_lovelace_supply = 100000020000000,
    num_dreps = count_dreps topology.nodes,
    peras = {
      perasMinCandidateBlockAge = 30,
      perasQuorumThresholdSafetyMargin = 0.02,
      perasTargetCommitteeSize = 5,
    },
  },
} | Scenario

