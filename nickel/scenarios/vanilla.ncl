        stake = 1/16,
      },
      { name = "pool32_1",
        role = 'spo,
        stake = 1/32,
      },
      { name = "pool32_2",
        role = 'spo,
        stake = 1/32,
      },
      { name = "relay1",
        role = 'relay,
      },
      { name = "relay2",
        role = 'relay,
      },
