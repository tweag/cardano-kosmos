#!/usr/bin/env python3
"""kint: manage the lockstep integration from its spec.

Usage:
  kint [--spec SPEC.toml] export   write the steps of the spec and its lock from the current git state
  kint [--spec SPEC.toml] verify   check the spec, the lock, the integration branches and the kosmos steps

SPEC defaults to peras-integration-main.toml next to this script. See README.md.
"""
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from kintlib import Spec, git, is_external, lock_path, read_kosmos, read_merges, ttable  # noqa: E402

STEPS_MARKER = "# ==== Steps"
STEPS_HEADER = f"""{STEPS_MARKER} ====
# One [[step]] per kosmos step, in order; its [[step.merge]] entries are the merges it brings, per repository in
# first-parent order. `kint export` rewrites this section from git and keeps the hand-written fields: `kosmos_side`,
# `kosmos_files`, `pr`, `pr_title`, `pr_draft`. `base`: repositories the step vendors at their upstream base.
"""


def from_git(spec):
    """The steps as git records them, and the problems found reading them."""
    ksteps, only = read_kosmos(spec)
    problems = []
    steps = [{"title": s["title"], "commit": s["commit"], "pins": s["pins"], "moved": s["moved"], "base": [],
              "merges": []} for s in ksteps]
    repos = {}
    for repo in spec.repo_order:
        base, merges = read_merges(spec, repo, ksteps)
        repos[repo] = {"base": base, "head": git(spec.wt(repo), "rev-parse", spec.repos[repo]["branch"]),
                       "merges": merges}
        for m in merges:
            if not m["ref"]:
                problems.append(f"{repo}: {m['commit'][:10]} on the first-parent history is not a `Merge <ref> (<desc>)`"
                                f" merge: {m['subject']}")
            elif m["step"] is None:
                problems.append(f"{repo}: {m['ref']} ({m['commit'][:10]}) is merged but in no step")
            else:
                steps[m["step"] - 1]["merges"].append(dict(m, repo=repo))
    for i, s in enumerate(steps, 1):
        for repo in s["moved"]:
            mine = [m for m in s["merges"] if m["repo"] == repo]
            pin = s["pins"][repo]
            if mine:
                if mine[-1]["commit"] != pin:
                    problems.append(f"step {i}: {repo} pin {pin[:10]} is not its last merge "
                                    f"{mine[-1]['commit'][:10]} ({mine[-1]['ref']})")
            elif git(spec.wt(repo), "rev-parse", pin) == repos[repo]["base"]:
                s["base"].append(repo)
            else:
                problems.append(f"step {i}: {repo} pin {pin[:10]} is neither a merge nor the base")
    return steps, only, repos, problems


def legacy(spec):
    """Hand-written data of the layout before [[step]]: [[pr]] and [kosmos_side]."""
    prs = {(x["repo"], x["ref"]): x for x in spec.config.get("pr", [])}
    side = {int(k): v for k, v in spec.config.get("kosmos_side", {}).items()}
    return prs, side


def cmd_export(spec):
    steps, only, repos, problems = from_git(spec)
    for p in problems:
        print(f"PROBLEM: {p}", file=sys.stderr)
    if problems:
        return 1
    old_steps = {s["title"]: s for s in spec.steps}
    old_merges = {(m["repo"], m["ref"]): m for _, m in spec.spec_merges()}
    legacy_prs, legacy_side = legacy(spec)

    out = [STEPS_HEADER]
    for i, s in enumerate(steps, 1):
        old = old_steps.get(s["title"], {})
        out.append(f"\n# ---- step {i}\n")
        out.append(ttable("[[step]]", {"title": s["title"], "base": s["base"] or None,
                                        "kosmos_side": old.get("kosmos_side") or legacy_side.get(i),
                                        "kosmos_files": old.get("kosmos_files")}))
        for m in s["merges"]:
            key = (m["repo"], m["ref"])
            om, lp = old_merges.get(key, {}), legacy_prs.get(key, {})
            out.append("\n" + ttable("[[step.merge]]", {
                "repo": m["repo"], "ref": m["ref"], "desc": m["desc"],
                "pr": om.get("pr") or lp.get("pr"),
                "pr_title": om.get("pr_title") or lp.get("title"),
                "pr_draft": om.get("pr_draft", lp.get("draft")) if (om.get("pr") or lp.get("pr")) else None,
            }, indent="  "))

    with open(spec.path) as f:
        text = f.read()
    cut = text.find(STEPS_MARKER)
    head = (text[:cut] if cut >= 0 else text).rstrip("\n") + "\n\n"
    with open(spec.path, "w") as f:
        f.write(head + "".join(out))

    # The kosmos-only commits are not recorded: the lock itself is committed in one of them.
    lock = ["# Generated by `kint export`: the SHAs the spec resolved to. Do not edit.\n\n",
            ttable("[kosmos]", {"base": git(spec.kosmos, "rev-parse", spec.kosmos_base),
                                "steps": [s["commit"] for s in steps]})]
    for repo in spec.repo_order:
        r = repos[repo]
        lock.append("\n" + ttable("[[repo]]", {"name": repo, "base": r["base"], "head": r["head"]}))
    for s in steps:
        for m in s["merges"]:
            key = (m["repo"], m["ref"])
            old, lp = spec.lock_merges.get(key, {}), legacy_prs.get(key, {})
            lock.append("\n" + ttable("[[merge]]", {
                "repo": m["repo"], "ref": m["ref"], "commit": m["commit"], "source": m["parents"][1],
                "pr_head": old.get("pr_head") or lp.get("head"),
                "adapted_from": old.get("adapted_from") or lp.get("adapted_from")}))
    with open(lock_path(spec.path), "w") as f:
        f.write("".join(lock))
    print(f"{len(steps)} steps, {sum(len(s['merges']) for s in steps)} merges, {len(only)} kosmos-only commits")
    print(f"wrote {spec.path}\nwrote {lock_path(spec.path)}")
    return 0


# ---- verify ---------------------------------------------------------------------

AI = re.compile(r"(?i)\bclaude\b|anthropic|claude-session|generated with|co-authored-by:.*\b(gpt|copilot|ai)\b")


class Report:
    def __init__(self):
        self.fails, self.warns = 0, 0

    def check(self, name, problems, warn=False):
        if problems:
            if warn:
                self.warns += 1
            else:
                self.fails += 1
            print(f"{'WARN' if warn else 'FAIL'} {name}")
            for p in problems[:30]:
                print(f"     {p}")
            if len(problems) > 30:
                print(f"     ... {len(problems) - 30} more")
        else:
            print(f"ok   {name}")


def cmd_verify(spec):
    rep = Report()
    steps, only, repos, problems = from_git(spec)
    rep.check("git: integration branches are only `Merge <ref> (<desc>)` merges, each in a step, pins are "
              "last merges or bases", problems)

    # The spec describes git.
    diff = []
    if len(spec.steps) != len(steps):
        diff.append(f"spec has {len(spec.steps)} steps, git has {len(steps)}")
    for i, (a, b) in enumerate(zip(spec.steps, steps), 1):
        if a["title"] != b["title"]:
            diff.append(f"step {i}: title {a['title']!r} in the spec, {b['title']!r} in git")
        if sorted(a.get("base", [])) != sorted(b["base"]):
            diff.append(f"step {i}: base {a.get('base', [])} in the spec, {b['base']} in git")
        sm = [(m["repo"], m["ref"], m["desc"]) for m in a.get("merge", [])]
        gm = [(m["repo"], m["ref"], m["desc"]) for m in b["merges"]]
        for x in sm:
            if x not in gm:
                diff.append(f"step {i}: spec merge not in git: {x[0]} {x[1]} ({x[2]})")
        for x in gm:
            if x not in sm:
                diff.append(f"step {i}: git merge not in the spec: {x[0]} {x[1]} ({x[2]})")
        for repo in spec.repo_order:
            so = [x for x in sm if x[0] == repo and x in gm]
            go = [x for x in gm if x[0] == repo and x in sm]
            if so != go:
                diff.append(f"step {i}: {repo} merges in a different order")
    rep.check("spec: steps and merges match git", diff)

    # The lock records git.
    stale = []
    lk = spec.lock.get("kosmos", {})
    if lk.get("steps") != [s["commit"] for s in steps]:
        stale.append("step commits differ")
    for s in steps:
        for m in s["merges"]:
            lm = spec.lock_merges.get((m["repo"], m["ref"]))
            if not lm or lm["commit"] != m["commit"] or lm["source"] != m["parents"][1]:
                stale.append(f"{m['repo']} {m['ref']}")
    rep.check("lock: SHAs match git (else run `kint export`)", stale)

    all_merges = [m for s in steps for m in s["merges"]]

    # Topics start from the integration commit they merge into; their local branch is what was merged.
    bad, moved = [], []
    for m in all_merges:
        if is_external(m["ref"]):
            continue
        wt, (p1, p2) = spec.wt(m["repo"]), m["parents"]
        if git(wt, "merge-base", p1, p2) != p1:
            bad.append(f"{m['repo']} {m['ref']}: does not start from {p1[:10]}")
        try:
            local = git(wt, "rev-parse", "--verify", f"refs/heads/{m['ref']}")
        except subprocess.CalledProcessError:
            moved.append(f"{m['repo']} {m['ref']}: no local branch")
            continue
        if local != p2:
            moved.append(f"{m['repo']} {m['ref']}: local branch {local[:10]}, merged {p2[:10]}")
    rep.check("topics: each starts from the integration commit it merges into", bad)
    rep.check("topics: each local branch equals what was merged", moved, warn=True)

    # External changesets are merged as-is: none is a cherry-pick adapted from a PR commit.
    asis = []
    for m in all_merges:
        lm = spec.lock_merges.get((m["repo"], m["ref"]), {})
        if is_external(m["ref"]) and lm.get("adapted_from"):
            asis.append(f"{m['repo']} {m['ref']}: an external changeset is merged as-is, it has no adapted_from")
    rep.check("external changesets: merged as-is", asis)

    # No AI mention in the merge messages, in the commits written with this clone's git identity (the commits of
    # other authors stay untouched), in the kosmos steps and in the kosmos-only commits.
    ai = []
    for m in all_merges:
        wt, (p1, p2) = spec.wt(m["repo"]), m["parents"]
        me = git(wt, "config", "user.email")
        msgs = [(m["commit"], git(wt, "log", "-1", "--format=%B", m["commit"]))]
        msgs += [(c, git(wt, "log", "-1", "--format=%B", c)) for c in git(wt, "rev-list", f"{p1}..{p2}").split()
                 if git(wt, "log", "-1", "--format=%ae", c) == me]
        ai += [f"{m['repo']} {c[:10]}" for c, b in msgs if AI.search(b)]
    for c in [s["commit"] for s in steps] + [c["commit"] for c in only]:
        if AI.search(git(spec.kosmos, "log", "-1", "--format=%B", c)):
            ai.append(f"kosmos {c[:10]}")
    rep.check("messages: no AI mention in the merges, the commits of this git identity and kosmos", ai)

    # Every step vendors exactly its pins.
    vend = []
    for i, s in enumerate(steps, 1):
        for repo, pin in s["pins"].items():
            entries = [l for l in git(spec.kosmos, "ls-tree", f"{s['commit']}:packages/{repo}").splitlines()
                       if not l.endswith("\t.gitrepo")]
            tree = subprocess.run(["git", "-C", spec.kosmos, "mktree"], input="\n".join(entries) + "\n",
                                  capture_output=True, text=True, check=True).stdout.strip()
            if tree != git(spec.wt(repo), "rev-parse", f"{pin}^{{tree}}"):
                vend.append(f"step {i} {repo}: vendored tree differs from {pin[:10]}")
    rep.check("steps: every subrepo's vendored tree is its pin's tree", vend)

    # Requirements name existing changesets and land no later than their dependents.
    step_of = {(m["repo"], m["ref"]): m["step"] for m in all_merges}
    first_pin = {repo: next((i for i, s in enumerate(steps, 1) if repo in s["pins"]), None)
                 for repo in spec.repo_order}
    req = []
    for x in spec.config.get("requires", []):
        d = step_of.get((x["repo"], x["ref"]))
        if d is None:
            req.append(f"no changeset {x['repo']} {x['ref']}")
            continue
        t = first_pin[x["needs_repo"]] if x["needs_ref"] == "@base" else step_of.get((x["needs_repo"], x["needs_ref"]))
        if t is None:
            req.append(f"no changeset {x['needs_repo']} {x['needs_ref']}")
        elif t > d:
            req.append(f"{x['repo']} {x['ref']} (step {d}) needs {x['needs_repo']} {x['needs_ref']} (step {t})")
    for table in ("includes", "kind_override"):
        req += [f"[[{table}]]: no changeset {x['repo']} {x['ref']}" for x in spec.config.get(table, [])
                if (x["repo"], x["ref"]) not in step_of]
    rep.check("config: requirements, includes and kind overrides name changesets in order", req)

    print(f"\n{rep.fails} failed, {rep.warns} warnings")
    return 1 if rep.fails else 0


def main(argv):
    here = os.path.dirname(os.path.abspath(__file__))
    spec_path = os.path.join(here, "peras-integration-main.toml")
    if len(argv) >= 2 and argv[0] == "--spec":
        spec_path, argv = argv[1], argv[2:]
    cmds = {"export": cmd_export, "verify": cmd_verify}
    if len(argv) != 1 or argv[0] not in cmds:
        print(__doc__, file=sys.stderr)
        return 2
    return cmds[argv[0]](Spec(spec_path))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
